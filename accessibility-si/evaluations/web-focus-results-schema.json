{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Accessibility SI selected-check results",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "run_id",
    "performed_at",
    "environment",
    "results",
    "human_review",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "suite_id": {
      "const": "web-focus-pilot"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "performed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent",
        "model",
        "browser",
        "os",
        "viewport",
        "zoom",
        "keyboard_settings"
      ],
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "browser": {
          "type": "string",
          "minLength": 1
        },
        "os": {
          "type": "string",
          "minLength": 1
        },
        "viewport": {
          "type": "string",
          "minLength": 1
        },
        "zoom": {
          "type": "string",
          "minLength": 1
        },
        "keyboard_settings": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/result"
      }
    },
    "human_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewer",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "completed"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "check_id",
        "testing_track",
        "baseline_procedure_id",
        "status",
        "stage",
        "artifact_sha256",
        "tester_type",
        "evidence",
        "rationale",
        "local_procedure_id"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "check_id": {
          "enum": [
            "focus-visible",
            "focus-not-obscured"
          ]
        },
        "testing_track": {
          "enum": [
            "section508-baseline",
            "supplemental-wcag22"
          ]
        },
        "baseline_procedure_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "not-applicable",
            "not-tested",
            "needs-human-review"
          ]
        },
        "stage": {
          "enum": [
            "initial",
            "remediated",
            "generated"
          ]
        },
        "artifact_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "tester_type": {
          "enum": [
            "human",
            "agent-browser",
            "source-inspection",
            "none"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "component",
              "action",
              "observation",
              "reference"
            ],
            "properties": {
              "component": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "type": "string",
                "minLength": 1
              },
              "observation": {
                "type": "string",
                "minLength": 1
              },
              "reference": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "local_procedure_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "check_id": {
                "const": "focus-visible"
              }
            }
          },
          "then": {
            "properties": {
              "testing_track": {
                "const": "section508-baseline"
              },
              "baseline_procedure_id": {
                "const": "2.A-FocusVisible"
              },
              "local_procedure_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "check_id": {
                "const": "focus-not-obscured"
              }
            }
          },
          "then": {
            "properties": {
              "testing_track": {
                "const": "supplemental-wcag22"
              },
              "baseline_procedure_id": {
                "type": "null"
              },
              "local_procedure_id": {
                "const": "SUP-WEB-FOCUS-01"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "pass",
                  "fail",
                  "not-applicable"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              },
              "artifact_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "tester_type": {
                "enum": [
                  "human",
                  "agent-browser"
                ]
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "human_review": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "human_review": {
            "properties": {
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
