<!DOCTYPE html>
    <head>
        <meta charset="utf-8">
        <title>21.A-ic-dna-1</title>
    </head>
<style>
body {
    font-family: Arial, sans-serif;
    background-color: #f0f0f0;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
}

.ticket-container {
    text-align: center;
    background-color: white;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.3);
}

button {
    padding: 10px 20px;
    font-size: 16px;
    cursor: pointer;
    background-color: #007bff;
    color: white;
    border: none;
    border-radius: 5px;
}

button:disabled {
    background-color: gray;
    cursor: not-allowed;
}
    </style>
    
</head>
<body>
    <div class="ticket-container">
        <h1>Confirm the seats</h1>
        <p>You have selected 3 seats 22D, 22C and 22A</p>
        <button id="confirm">Confirm Purchase</button>
    </div>
</body>
</html>

