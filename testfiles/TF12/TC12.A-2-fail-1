<!doctype html>
<html lang="en-us">
<head>
  <meta charset="utf-8">
  <title>TC12.A-2-fail-1</title>
  <style>
    table {
      border-collapse: collapse;
      margin: 1rem;
    }

    th,
    td {
      border: 1px solid #333;
      padding: 0.5rem 1rem;
      text-align: left;
    }

    th {
      background-color: #d9eaf7;
    }
  </style>
</head>

<body>
  <div id="tc_code">
    <h1>Course Grade Weights</h1>

    <table role="grid">
      <tr>
        <th rowspan="2" id="h">Homework</th>
        <th colspan="3" id="e">Exams</th>
        <th colspan="3" id="p">Projects</th>
      </tr>
      <tr>
        <th id="e1" headers="e">Exam 1</th>
        <th id="e2" headers="e">Exam 2</th>
        <th id="ef" headers="e">Final Exam</th>
        <th id="p1" headers="p">Project 1</th>
        <th id="p2" headers="p">Project 2</th>
        <th id="pf" headers="p">Final Project</th>
      </tr>
      <tr>
        <td headers="h">Percentage</td>
        <td headers="e e1">15%</td>
        <td headers="e e2">15%</td>
        <td headers="e ef">20%</td>
        <td headers="p p1">10%</td>
        <td headers="p p2">10%</td>
        <td headers="p pf">15%</td>
      </tr>
    </table>
  </div>
</body>
</html>
