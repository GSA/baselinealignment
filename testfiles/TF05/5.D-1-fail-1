<!DOCTYPE html>
    <head>
        <meta charset="utf-8">
        <title>5.D-1-fail-1</title>
    </head>
    <body>
<label for="dropdown">Select a color:</label>
        <select id="dropdown" name="color">
            <option value="red">Red</option>
            <option value="green">Green</option>
            <option value="blue">Blue</option>
            <!-- Selected value not in the dropdown -->
            <option value="purple" selected hidden>Purple</option>
        </select>
</body>
</html>
