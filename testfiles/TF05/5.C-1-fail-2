<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>TC5.C-1-fail-2</title>
  <style>
    .preference-option {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem;
    }
  </style>
</head>

<body>
  <div id="tc_code">
    <h1>Notification Preferences</h1>

    <div class="preference-option">
      <input
        type="checkbox"
        id="email-updates"
        name="email-updates"
        aria-disabled="true">

      <label for="email-updates">
        Send me email updates
      </label>
    </div>
  </div>
</body>
</html>
