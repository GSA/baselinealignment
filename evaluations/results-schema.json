{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gsa.github.io/baselinealignment/evaluations/results-schema.json",
  "title": "Baseline Alignment Framework test process evaluation result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite",
    "run",
    "process",
    "environment",
    "scope",
    "artifact",
    "results",
    "case_comparisons",
    "human_review",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "framework_revision", "baseline_version", "baseline_source_revision"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "framework_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "baseline_version": { "type": "string", "minLength": 1 },
        "baseline_source_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "stage", "performed_at", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "stage": { "enum": ["initial", "rerun", "remediated"] },
        "performed_at": { "type": ["string", "null"], "format": "date-time" },
        "status": { "enum": ["planned", "in-progress", "completed", "stopped"] },
        "prior_run_id": { "type": ["string", "null"] }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "description", "owner", "components", "decision_rules", "reporting_conventions"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "type", "version", "configuration", "procedures_addressed", "limitations"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "type": {
                "enum": [
                  "manual-procedure",
                  "automated-tool",
                  "browser-tool",
                  "assistive-technology",
                  "script",
                  "ai-si-tool",
                  "human-review",
                  "organizational-subprocess",
                  "other"
                ]
              },
              "version": { "type": "string", "minLength": 1 },
              "configuration": { "type": "string", "minLength": 1 },
              "procedures_addressed": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
              "limitations": { "type": "array", "items": { "type": "string" } },
              "profile": { "type": ["object", "null"] }
            }
          }
        },
        "decision_rules": { "type": "array", "items": { "type": "string" } },
        "reporting_conventions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operating_system", "browser_or_native_application", "assistive_technologies", "input_methods", "viewport_or_view", "zoom", "tools", "additional_conditions"],
      "properties": {
        "operating_system": { "type": "string", "minLength": 1 },
        "browser_or_native_application": { "type": "string", "minLength": 1 },
        "assistive_technologies": { "type": "array", "items": { "type": "string" } },
        "input_methods": { "type": "array", "items": { "type": "string" } },
        "viewport_or_view": { "type": "string", "minLength": 1 },
        "zoom": { "type": "string", "minLength": 1 },
        "tools": { "type": "array", "items": { "type": "string" } },
        "additional_conditions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluation_type", "domain", "selection_rationale", "process_procedures", "selected_case_ids", "uncovered_procedures", "dispositions"],
      "properties": {
        "evaluation_type": { "enum": ["full-process", "component", "subprocess"] },
        "domain": { "enum": ["web", "documents", "mixed"] },
        "selection_rationale": { "type": "string", "minLength": 1 },
        "process_procedures": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "selected_case_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "uncovered_procedures": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "dispositions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target_id", "disposition", "basis"],
            "properties": {
              "target_id": { "type": "string", "minLength": 1 },
              "disposition": { "type": "string", "minLength": 1 },
              "basis": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path_or_url", "sha256", "dependencies"],
      "properties": {
        "path_or_url": { "type": "string", "minLength": 1 },
        "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path_or_url", "sha256"],
            "properties": {
              "path_or_url": { "type": "string", "minLength": 1 },
              "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_id", "case_id", "status", "completeness", "performed_by", "evidence", "rationale", "limitations"],
        "properties": {
          "target_id": { "type": "string", "minLength": 1 },
          "case_id": { "type": ["string", "null"] },
          "status": { "enum": ["pass", "fail", "not-applicable", "not-tested", "incomplete"] },
          "completeness": { "enum": ["complete", "partial", "not-started"] },
          "performed_by": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "rationale": { "type": "string", "minLength": 1 },
          "limitations": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "case_comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "target_id", "candidate_status", "expected_status", "comparison", "expectation_version", "evaluator", "rationale"],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "target_id": { "type": "string", "minLength": 1 },
          "candidate_status": { "enum": ["pass", "fail", "not-applicable", "not-tested", "incomplete"] },
          "expected_status": { "enum": ["pass", "fail", "not-applicable"] },
          "comparison": { "enum": ["matched", "mismatched", "not-compared"] },
          "expectation_version": { "type": "string", "minLength": 1 },
          "evaluator": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "human_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewers", "evidence", "pending_work"],
      "properties": {
        "status": { "enum": ["pending", "in-progress", "completed", "not-applicable"] },
        "reviewers": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "pending_work": { "type": "array", "items": { "type": "string" } }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  }
}
