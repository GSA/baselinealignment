---
---
{% assign testcasePages = site.pages | where: "layout", "testcase" %}[{% for page in testcasePages %}  {% assign baselineID = page.tcid | remove_first: "TC" | split: "." | first | plus: 0 %}  {% assign baseline = nil %}  {% for candidate in site.data.baselines %}    {% assign candidateID = candidate.id | plus: 0 %}    {% if candidateID == baselineID %}      {% assign baseline = candidate %}      {% break %}    {% endif %}{% endfor %}
  {
    "testCaseID": {{ page.tcid | jsonify }},
    "testCaseName": {{ page.title | smartify | jsonify }},
    "testCaseUrl": {{ site.url | append: site.baseurl | append: page.url | jsonify }},
    "sampleFileUrl": {{ site.url | append: site.baseurl | append: page.sample | jsonify }},
    "baselineExpectedResult": {{ page.result | upcase | jsonify }},
    "relatedBaseline": {{ baseline.name | jsonify }},
    "relevantStandard": {{ page.standard | jsonify }},
    "standardReference": {{ page.standard-ref | jsonify }}
  }{% unless forloop.last %},{% endunless %}{% endfor %}
]
